# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/dmdfs/releases/download/vlatest/versions.dmm

# Module entries with version placeholder - will be expanded by $version-available
dmdevfs https://github.com/choco-technologies/dmdfs/releases/download/v<version>/dmdevfs-v<version>-<arch_name>.zip

# dmdevmon - monitor service Application (services/dmdevmon), built and
# released together with dmdevfs
dmdevmon https://github.com/choco-technologies/dmdfs/releases/download/v<version>/dmdevmon-v<version>-<arch_name>.zip

# devscan - driver configuration directories of mount points (services/devscan),
# built and released together with dmdevfs
devscan https://github.com/choco-technologies/dmdfs/releases/download/v<version>/devscan-v<version>-<arch_name>.zip
